# =============================================================================
# 知曜后端环境变量样例（.env.example）
# 复制为 .env 后按需填写。逐项对照 app/config.py::Settings。
# ⚠️ 本文件会提交进仓库，只能写占位/说明，禁止写入任何真实密钥。
# 标「必填」的项无默认值，缺失会导致应用启动直接 raise。
# =============================================================================

# -----------------------------------------------------------------------------
# 核心必需（数据库 / Redis）
# -----------------------------------------------------------------------------
# 必填·无默认。异步 SQLAlchemy，必须用 postgresql+asyncpg 驱动
DATABASE_URL=postgresql+asyncpg://zhiyao:zhiyao_dev_password@localhost:5432/zhiyao

# 缓存 + Token 配额计数（默认本地 db0）
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# LLM（DeepSeek V4 Flash 主模型，OpenAI 兼容接口）
# -----------------------------------------------------------------------------
# 主 LLM Key。留空则 LLM 调用静默降级（Agent/笔记生成失效）。生产必填
DEEPSEEK_API_KEY=sk-填入-DeepSeek-控制台-API-Key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 备用模型 Key（已弃用，留空即可）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# 嵌入 / RAG（BGE-M3 本地，sentence-transformers，零云依赖）
# -----------------------------------------------------------------------------
EMBEDDING_PROVIDER=bge-m3
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
# HuggingFace 模型缓存目录（首次下载约 1.3GB BGE-M3 模型到此处）
HF_HOME=./.cache/huggingface

# -----------------------------------------------------------------------------
# 安全（JWT 用户 / 管理后台 / 配额）
# -----------------------------------------------------------------------------
# 必填·无默认。生产用 `openssl rand -hex 32` 生成的 64 字符随机串，禁用样例值
JWT_SECRET_KEY=必填-生产用-openssl-rand-hex-32-生成的-64字符随机串
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=30

# 管理后台独立密钥（留空则管理后台登录禁用）。生产同样用 openssl rand -hex 32 另生成一串
# ⚠️ 生产必须独立配置且 ≠ JWT_SECRET_KEY（共用同一秘密会让用户态+后台一起沦陷）
ADMIN_JWT_SECRET=生产用-openssl-rand-hex-32-另生成的独立随机串
ADMIN_TOKEN_EXPIRE_HOURS=12

# 一次性创建首个超级管理员用的口令（与签名密钥无关，不参与任何 token 签名）。
# /admin/auth/setup 凭此校验。留空 = 禁用 setup（不允许创建超管）。
# 创建首个 admin 后可清空。生产用独立随机串
ADMIN_SETUP_TOKEN=生产用-一次性创建首个管理员的独立随机口令

# 默认每日 Token 配额（所有用户）
DEFAULT_DAILY_TOKEN_LIMIT=200000

# -----------------------------------------------------------------------------
# 订阅（RevenueCat Webhook）
# -----------------------------------------------------------------------------
# RevenueCat Dashboard → Webhooks → Authorization: Bearer <此值>
# 留空 = webhook 禁用（订阅生命周期事件不生效）。生产必填
REVENUECAT_WEBHOOK_SECRET=填入-RevenueCat-Webhook-Authorization-密钥

# -----------------------------------------------------------------------------
# 文件存储
# -----------------------------------------------------------------------------
STORAGE_TYPE=local
LOCAL_UPLOAD_DIR=./uploads
# 用于将相对 URL 转为绝对 URL（教材图片解析），生产填真实域名
PUBLIC_BASE_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Celery（异步任务：笔记生成 / 通知 / 每日任务 / RAG 嵌入）
# -----------------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# -----------------------------------------------------------------------------
# 应用 / CORS
# -----------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# G2-4 可观测 · Sentry 错误上报（审计 P0）
# 留空（默认）= 不 init、不上报，本地开发零依赖；生产填 Sentry 项目 DSN 才接入。
# 形如 https://<key>@<org>.ingest.sentry.io/<project_id>
SENTRY_DSN=
# 性能追踪采样率 0.0-1.0（仅 DSN 非空时生效）
SENTRY_TRACES_SAMPLE_RATE=0.1
# 逗号分隔的允许来源；生产填前端真实域名
ALLOWED_ORIGINS=http://localhost:3000
# 可选：CORS 来源正则（留空 = 不启用正则匹配）
ALLOWED_ORIGIN_REGEX=

# -----------------------------------------------------------------------------
# 学习内核 feature flag
# -----------------------------------------------------------------------------
# 引擎驱动模式（默认开；设 False 一键回退旧 ReAct）
LEARNING_ENGINE_ENABLED=true
# 增益函数排序（默认关；未经真实数据校准前不上生产）
LEARNING_GAIN_ENABLED=false
